OLLAMA_MODEL=qwen3-coder:30b
OLLAMA_BASE_URL=http://localhost:11434
APP_DATA_DIR=.local-agent-chat

# Chainlit secret
# how to generate: chainlit create-secret
# then add secret into your project .env
CHAINLIT_AUTH_SECRET="your-generated-secret"

# Recommended by langgraph-checkpoint-sqlite for safer checkpoint deserialization.
LANGGRAPH_STRICT_MSGPACK=true

# File limits
MAX_UPLOAD_FILE_MB=20
MAX_CHAT_FILES_MB=200

OLLAMA_MODEL_KEEP_ALIVE=5m
OLLAMA_VISION_KEEP_ALIVE=0

# Collection agent model. Default keeps the whole app on local Ollama.
# Set to gigachat to use GigaChat only for Collection Simulator.
COLLECTION_MODEL_PROVIDER=ollama
# GIGACHAT_CREDENTIALS=
# GIGACHAT_SCOPE=GIGACHAT_API_PERS
# GIGACHAT_MODEL=GigaChat-3-Ultra
# Prefer TLS verification; if needed configure GIGACHAT_CA_BUNDLE_FILE.

# Collection Simulator
# demo: embedded deterministic fixture, no database required
# greenplum: read collection_sim.* tables using GP_* settings below
COLLECTION_SIM_MODE=demo

# Required only for COLLECTION_SIM_MODE=greenplum
GP_HOST=127.0.0.1
GP_PORT=5432
GP_DATABASE=demo
GP_USER=gpadmin
GP_PASSWORD=change-me
